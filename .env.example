# PyMyCorr Configuration
# Copy this file to .env and fill in your values.

# Required: Your MyCorr API token (Bearer token from MyCorr UI)
MYCORR_API_TOKEN=your-token-here

# Optional: Override the API base URL (no path segments)
# The client appends /data/table/stream and /data/tableinfo internally.
# MYCORR_API_URL=https://mycorr.app

# For local development (SSL verification auto-disabled for localhost/127.0.0.1):
# MYCORR_API_URL=https://localhost:8443
